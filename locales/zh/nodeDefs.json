{
  "RuYiMultiLoraLoader": {
    "display_name": "RuYi multi-Lora-loader",
    "description": "多 LoRA 加载器，分别控制模型与 CLIP 权重，并读取 LoRA Manager 资料。",
    "inputs": {
      "model": {
        "name": "模型"
      },
      "clip": {
        "name": "CLIP"
      },
      "stack_config": {
        "name": "LoRA 列表"
      }
    },
    "outputs": {
      "0": {
        "name": "模型"
      },
      "1": {
        "name": "CLIP"
      },
      "2": {
        "name": "触发词"
      }
    }
  },
  "RuYiMultiLoraLoaderModelOnly": {
    "display_name": "RuYi multi-Lora-loader（仅模型）",
    "description": "仅作用于模型的多 LoRA 加载器，并读取 LoRA Manager 资料。",
    "inputs": {
      "model": {
        "name": "模型"
      },
      "stack_config": {
        "name": "LoRA 列表"
      }
    },
    "outputs": {
      "0": {
        "name": "模型"
      },
      "1": {
        "name": "触发词"
      }
    }
  },
  "RuYiTextPreview": {
    "display_name": "RuYi 文本监视",
    "description": "运行后显示输入 STRING 的完整内容，并原样输出。",
    "inputs": {
      "text": {
        "name": "文本"
      }
    },
    "outputs": {
      "0": {
        "name": "STRING"
      }
    }
  }
}